@page "/mqtt-nachrichten"
@inject InstanceStore Instances
@implements IAsyncDisposable
@inject LiveStore Store

<PageTitle>MQTT-Nachrichten · EnergyTwin</PageTitle>
<div class="page-heading"><h1>MQTT-Nachrichten</h1></div>
<section class="diagnostics" aria-labelledby="mqtt-heading">
    <div class="section-heading">
        <div>
            <h2 id="mqtt-heading">MQTT-Diagnose</h2>
            <p class="@(_snapshot.Connected ? "green" : "muted")">@_snapshot.Connection</p>
        </div>
        <button aria-expanded="@(_showDiagnostics ? "true" : "false")" aria-controls="mqtt-details"
                @onclick="() => _showDiagnostics = !_showDiagnostics">
            @(_showDiagnostics ? "Nachrichten ausblenden" : $"Nachrichten anzeigen ({_messages.Length})")
        </button>
    </div>
    <div id="mqtt-details" hidden="@(!_showDiagnostics)">
        @if (_showDiagnostics)
        {
            <p class="muted small diagnostics-count">@_snapshot.Rejected verworfene Nachrichten</p>
            <div class="catalog-filters"><label for="live-search">Topic oder Instanz suchen<input id="live-search" type="search" @bind="_search" @bind:event="oninput" /></label></div>
            @if (_messages.Length == 0)
            {
                <div class="empty-state"><h2>Keine weiteren MQTT-Nachrichten</h2><p>Messwerte bekannter Feldgeräte stehen in der Anlagenübersicht.</p></div>
            }
            @foreach (var message in _messages.Where(m => m.Topic.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                <MqttMessageDetails @key="message.Topic" Message="message" Snapshot="_snapshot" />
            }
            @if (_messages.Length > 0 && !_messages.Any(m => m.Topic.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                <p class="empty-state">Keine Topics passen zum Suchbegriff.</p>
            }
        }
    </div>
</section>

@code {
    private readonly CancellationTokenSource _stop = new();
    private Task? _refreshTask;
    private string _search = string.Empty;
    private bool _showDiagnostics = true;
    private LiveSnapshot _snapshot = null!;

    private LiveMessage[] _messages = [];

    private void Refresh()
    {
        _snapshot = Store.Snapshot();
        var onDashboard = Instances.Instances.Where(instance => DeviceSessions.Supports(instance.Kind))
            .Select(instance => LiveStore.DeviceMeasurementsTopic(instance.Id)).ToHashSet(StringComparer.Ordinal);
        _messages = _snapshot.Messages.Where(message => !onDashboard.Contains(message.Topic)).ToArray();
    }

    protected override void OnInitialized() => Refresh();
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _refreshTask = RefreshAsync();
        return Task.CompletedTask;
    }

    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(() => { Refresh(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        if (_refreshTask is not null) await _refreshTask;
        _stop.Dispose();
    }
}


