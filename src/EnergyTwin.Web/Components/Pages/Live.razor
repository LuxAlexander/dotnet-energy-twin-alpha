@page "/"
@implements IAsyncDisposable
@inject PlantStatus Plant
@inject InstanceStore Instances
@inject ProcessManager Processes

<PageTitle>Anlagenübersicht · EnergyTwin</PageTitle>
<header class="plant-hero">
    <div class="hero-content">
        <h1>Anlagenübersicht</h1>
        <div class="hero-actions">
            <a class="button-link button-primary" href="/instanz/neu">Instanz hinzufügen</a>
            <a class="button-link" href="/fehlerdiagnose">Fehlerdiagnose</a>
        </div>
    </div>
    <dl class="plant-summary">
        <div><dt>Gestartete Feldgeräte</dt><dd>@RunningCount<span> / @DeviceCount</span></dd></div>
        <div class="@(_snapshot.Issues.Length > 0 ? "has-issues" : null)">
            <dt>Fehlermeldungen</dt><dd>@_snapshot.Issues.Length</dd>
        </div>
        <div><dt>MQTT</dt><dd class="connection-value">@(_snapshot.Mqtt.Connected ? "Verbunden" : "Getrennt")</dd></div>
    </dl>
</header>

<section class="plant-section" aria-labelledby="device-heading">
    <div class="plant-section-heading">
        <h2 id="device-heading">Feldgeräte</h2>
        <div class="plant-filters" aria-label="Feldgeräte filtern">
            <button aria-pressed="@(!_faultsOnly)" @onclick="() => _faultsOnly = false">Alle Geräte</button>
            <button aria-pressed="@_faultsOnly" @onclick="() => _faultsOnly = true">Mit Fehlern</button>
        </div>
    </div>
    @if (!Devices.Any())
    {
        <p class="empty-state">@(_faultsOnly ? "Keine Feldgeräte mit Fehlern." : "Noch keine Feldgeräte angelegt.")</p>
    }
    else
    {
        <div class="plant-cards">@foreach (var item in Devices)
            {
                @Card(item)
            }
        </div>
    }
</section>

<section class="plant-section" aria-labelledby="infrastructure-heading">
    <div class="plant-section-heading">
        <h2 id="infrastructure-heading">Infrastruktur</h2>
        <a href="/mqtt-nachrichten">MQTT-Nachrichten</a>
    </div>
    <div class="plant-cards infrastructure-cards">
        @foreach (var item in _snapshot.Instances.Where(item => !DeviceSessions.Supports(item.Config.Kind))
            .OrderByDescending(item => item.Issues.Length > 0))
        {
            @Card(item)
        }
    </div>
</section>

@code {
    private readonly CancellationTokenSource _stop = new();
    private readonly Dictionary<string, string> _results = new();
    private Task? _refresh;
    private PlantSnapshot _snapshot = null!;
    private string? _starting;
    private string? _expandedId;
    private bool _faultsOnly;
    private int DeviceCount => _snapshot.Instances.Count(item => DeviceSessions.Supports(item.Config.Kind));
    private int RunningCount => _snapshot.Instances.Count(item => DeviceSessions.Supports(item.Config.Kind) && item.Running);
    private IEnumerable<PlantInstance> Devices => _snapshot.Instances
        .Where(item => DeviceSessions.Supports(item.Config.Kind) && (!_faultsOnly || item.Issues.Length > 0))
        .OrderByDescending(item => item.Issues.Length > 0).ThenByDescending(item => item.Running).ThenBy(item => item.Config.Kind);

    private RenderFragment Card(PlantInstance item) => @<article @key="item.Config.Id"
        class="plant-card @(item.Issues.Length > 0 ? "plant-card-fault" : null) @(_expandedId == item.Config.Id ? "plant-card-expanded" : null)">
        <div class="plant-card-top">
            <span>@item.Config.Group</span>
            <span class="plant-status @(item.Issues.Length > 0 ? "status-fault" : item.Running ? "status-running" : "")">
                @(_starting == item.Config.Id ? "Startet …" : item.Status)
            </span>
        </div>
        <h3><a href="@("/module/" + Uri.EscapeDataString(item.Config.Id))">@item.Config.Name</a></h3>
        @if (DeviceSessions.Supports(item.Config.Kind))
        {
            <p class="plant-location">@item.Config.Location</p>
        }
        @if (item.Metric is { } metric)
        {
            <div class="plant-metric">
                <span>@metric.Label</span>
                <strong class="@metric.Tone">@metric.Value <small>@metric.Unit</small></strong>
            </div>
        }
        @if (item.Issues.FirstOrDefault() is { } issue)
        {
            <a class="card-issue" href="@($"/fehlerdiagnose#fehler-{Uri.EscapeDataString(issue.Key)}")">@issue.Title</a>
        }
        @if (DeviceSessions.Supports(item.Config.Kind) || ShowStart(item))
        {
            <div class="plant-card-actions">
                @if (ShowStart(item))
                {
                    <button disabled="@(_starting is not null)" aria-label="@($"{item.Config.Name} starten")"
                            @onclick="() => StartAsync(item.Config)">Starten</button>
                }
                @if (DeviceSessions.Supports(item.Config.Kind))
                {
                    <button aria-expanded="@(_expandedId == item.Config.Id ? "true" : "false")"
                            aria-label="@($"{item.Config.Name}: Messwerte {(_expandedId == item.Config.Id ? "ausblenden" : "anzeigen")}")"
                            @onclick="() => _expandedId = _expandedId == item.Config.Id ? null : item.Config.Id">
                        @(_expandedId == item.Config.Id ? "Messwerte ausblenden" : "Messwerte anzeigen")
                    </button>
                }
            </div>
        }
        @if (_results.TryGetValue(item.Config.Id, out var notice))
        {
            <p class="plant-notice" role="status">@notice</p>
        }
        @if (_expandedId == item.Config.Id)
        {
            var topic = LiveStore.DeviceMeasurementsTopic(item.Config.Id);
            var message = _snapshot.Mqtt.Messages.FirstOrDefault(message => message.Topic == topic);
            @if (message is null)
            {
                <p class="muted plant-no-measurements">Für diese Instanz wurden noch keine MQTT-Messwerte empfangen.</p>
            }
            else
            {
                <MqttMessageDetails @key="topic" Message="message" Snapshot="_snapshot.Mqtt" InitiallyOpen="true" />
            }
        }
    </article>;

    private bool ShowStart(PlantInstance item) =>
        (!item.Running && item.ProcessState == InstanceRunState.NotTracked) || _starting == item.Config.Id;

    protected override void OnInitialized() => _snapshot = Plant.Read();
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _refresh = RefreshAsync();
        return Task.CompletedTask;
    }

    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(() => { _snapshot = Plant.Read(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }

    private async Task StartAsync(InstanceConfig instance)
    {
        if (_starting is not null) return;
        _starting = instance.Id;
        _results.Remove(instance.Id);
        try { _results[instance.Id] = await Processes.StartInstanceAsync(instance, Instances.Instances); }
        finally { _starting = null; _snapshot = Plant.Read(); }
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        if (_refresh is not null) await _refresh;
        _stop.Dispose();
    }
}
