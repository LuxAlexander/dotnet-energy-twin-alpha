@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject EnergyTwin.Web.Live.MasterControlClient MasterControl
@using SimCore.Contracts
@using EnergyTwin.Web.Management
@using Microsoft.JSInterop
@inject InstanceStore InstanceStore
@inject ProcessManager ProcessManager
@inject IJSRuntime JS

<a class="skip-link" href="#main-content">Zum Inhalt</a>
<div class="app-shell">
    <aside class="sidebar" aria-label="Module und Geräte">
        <a class="brand" href="/">EnergyTwin</a>
        <nav class="main-nav" aria-label="Hauptnavigation">
            <NavLink href="/" Match="NavLinkMatch.All">Live-Anlage</NavLink>
            <NavLink href="/short-info">Short Info</NavLink>
        </nav>
        <details class="module-nav">
            <summary>Module und Geräte</summary>
            @foreach (var group in InstanceStore.Instances.GroupBy(instance => instance.Group))
            {
                <div class="nav-group">
                    <p>@group.Key</p>
                    @foreach (var instance in group)
                    {
                        <NavLink href="@($"module/{instance.Id}")">
                            @instance.Name <small>@instance.Location</small>
                        </NavLink>
                    }
                </div>
            }
            <a href="/instanz/neu">Instanz hinzufügen</a>
        </details>
        <label class="theme-select">
            Darstellung
            <select @bind="_theme" @bind:after="ApplyThemeAsync">
                <option value="system">System</option>
                <option value="light">Hell</option>
                <option value="dark">Dunkel</option>
            </select>
        </label>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <div class="plant-time">
                <span class="eyebrow">Virtuelle Zeit</span>
                @if (_masterStatus is { } status)
                {
                    <div class="plant-clock">
                        <strong>@status.SimTime.ToString("HH:mm:ss")</strong>
                        <span>@status.SimTime.ToString("dd.MM.yyyy")</span>
                    </div>
                }
                <span class="plant-mode @(MasterTone)">@MasterModeText</span>
            </div>
            <div class="actions">
                @{ var resume = !MasterRunning; }
                <button @onclick="() => SendMasterAsync(resume)" disabled="@(_busy || _commandBusy || !_masterAvailable || MasterChanging)">
                    @(_commandBusy ? "Warte auf Master…" : MasterRunning ? "Pausieren" : "Fortsetzen")
                </button>
                <button class="button-primary" @onclick="StartPlant" disabled="@(_busy || _commandBusy || AllRunning)">
                    @(_busy && !_confirmClose ? "Start läuft…" : "Alles starten")
                </button>
                <button class="button-danger" @onclick="RequestCloseAll" disabled="@(_busy || _commandBusy || _confirmClose)">Alles beenden</button>
            </div>
        </header>
        @if (_confirmClose)
        {
            <div class="action-panel" role="group" aria-labelledby="close-plant-heading">
                <h2 id="close-plant-heading">Alle Anlagenmodule beenden?</h2>
                <p>Die Simulation stoppt und Gerätezustände können verloren gehen. RabbitMQ läuft weiter.</p>
                <div class="actions">
                    <button @onclick="() => _confirmClose = false" disabled="@_busy">Abbrechen</button>
                    <button class="button-danger" @onclick="CloseAll" disabled="@(_busy || _commandBusy)">@(_busy ? "Wird beendet…" : "Beenden bestätigen")</button>
                </div>
            </div>
        }
        @if (_lastNotice is not null || _results.Count > 0)
        {
            <div class="action-panel action-result">
                <div class="section-heading">
                    <p role="status">@(_lastNotice ?? "Rückmeldungen der Anlage")</p>
                    <button @onclick="DismissResult" aria-label="Rückmeldung ausblenden">Ausblenden</button>
                </div>
                @if (_results.Count > 0)
                {
                    <details>
                        <summary>Details zu @_results.Count Modulen</summary>
                        <ul>
                            @foreach (var result in _results)
                            {
                                <li>@result</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        }
        <main id="main-content">@Body</main>
    </div>
</div>
@code {
    private readonly CancellationTokenSource _stop = new();
    private Task? _refreshTask;
    private MasterStatus? _masterStatus;
    private bool _masterAvailable;
    private bool _commandBusy;
    private string _theme = "system";
    private bool MasterRunning => _masterStatus?.Current.Mode == SimMode.Running;
    private bool MasterChanging => _masterStatus is { } status && status.Current.Sequence != status.Latest.Sequence;
    private string MasterTone => !_masterAvailable ? "red" : MasterRunning ? "green" : "gold";
    private string MasterModeText => _masterStatus is not { } status ? "Master-Status ausstehend"
        : !_masterAvailable ? "Letzter Stand · warte auf Master"
        : $"{(MasterRunning ? "Läuft" : "Pausiert")} · {status.Current.Speed:g}× · Lauf {status.Current.RunId}"
            + (status.Current.Sequence != status.Latest.Sequence ? " · Wechsel angekündigt" : "");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _theme = await JS.InvokeAsync<string>("energyTwinTheme.get");
        StateHasChanged();
    }

    private async Task ApplyThemeAsync() => await JS.InvokeVoidAsync("energyTwinTheme.set", _theme);

    private void DismissResult()
    {
        _lastNotice = null;
        _results = [];
    }

    protected override void OnInitialized() => _refreshTask = RefreshMasterAsync();

    private async Task RefreshMasterAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            do
            {
                await InvokeAsync(() =>
                {
                    (_masterStatus, _masterAvailable) = MasterControl.Snapshot();
                    StateHasChanged();
                });
            } while (await timer.WaitForNextTickAsync(_stop.Token));
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }

    private async Task SendMasterAsync(bool running)
    {
        if (_commandBusy || _busy) return;
        _commandBusy = true;
        try { _lastNotice = await MasterControl.SendAsync(running, _stop.Token); }
        finally { _commandBusy = false; }
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        if (_refreshTask is not null) await _refreshTask;
        _stop.Dispose();
    }

    private IReadOnlyList<StartStepResult> _results = Array.Empty<StartStepResult>();
    private string? _lastNotice;
    private bool _confirmClose;
    private bool _busy;

    private bool AllRunning => InstanceStore.Instances.All(instance =>
        instance.Kind is ModuleKind.Broker ||
        ProcessManager.State(instance) is InstanceRunState.ManagedRunning or InstanceRunState.ExternallyReachable);

    private async Task StartPlant()
    {
        if (_busy || _commandBusy) return;
        _busy = true;
        try
        {
            var configs = InstanceStore.StartupOrder();
            var results = new List<StartStepResult>();
            var broker = configs.FirstOrDefault(instance => instance.Kind == ModuleKind.Broker);
            if (broker is not null) results.Add(await ProcessManager.StartBrokerAsync());
            foreach (var config in configs)
            {
                if (config.Kind is ModuleKind.Broker) continue;
                var result = config.Kind is ModuleKind.Gateway
                    ? await ProcessManager.SyncGatewayAsync(configs, startIfStopped: true)
                    : await ProcessManager.StartAsync(config, configs);
                if (result is not null) results.Add(result);
            }
            _results = results;

            // Nach dem Start warten, bis der Time Master über MQTT erreichbar ist,
            // und ihn automatisch fortsetzen, damit die virtuelle Zeit sofort läuft.
            var masterReady = false;
            for (int i = 0; i < 20; i++) // bis zu 10 Sekunden
            {
                await Task.Delay(500, _stop.Token);
                if (MasterControl.Snapshot().Available)
                {
                    masterReady = true;
                    break;
                }
            }

            if (masterReady)
            {
                _lastNotice = MasterControl.Snapshot().Status?.Latest.Mode == SimMode.Running
                    ? "Der Master ist verbunden und die Simulation läuft."
                    : await MasterControl.SendAsync(true, _stop.Token);
            }
            else
            {
                _lastNotice = "Startrunde abgeschlossen. Die Web-App wartet weiter auf den Master-Status. Sobald die Steuerung bereit ist, kannst du die Simulation fortsetzen.";
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        finally
        {
            _confirmClose = false;
            _busy = false;
            StateHasChanged();
        }
    }

    private void RequestCloseAll() => _confirmClose = true;

    private async Task CloseAll()
    {
        if (_busy || _commandBusy) return;
        _busy = true;
        try
        {
            _results = await ProcessManager.StopAllAsync(InstanceStore.Instances);
            _lastNotice = _results.Count == 0
                ? "Keine verwalteten Prozesse beendet; Broker blieb nicht berührt."
                : "Geordnetes Schließen abgeschlossen; Broker blieb unberührt.";
        }
        finally
        {
            _confirmClose = false;
            _busy = false;
            StateHasChanged();
        }
    }
}
