@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject EnergyTwin.Web.Live.MasterControlClient MasterControl
@using SimCore.Contracts
@using EnergyTwin.Web.Management
@inject InstanceStore InstanceStore
@inject ProcessManager ProcessManager

<a class="skip-link" href="#main-content">Zum Inhalt</a>
<div class="app-shell">
    <aside class="sidebar" aria-label="Module und Geräte">
        <a class="brand" href="/">EnergyTwin<span>Lokale Oberfläche</span></a>
        <NavLink href="/" Match="NavLinkMatch.All">Live-Anlage</NavLink>
        <NavLink href="/vorschau">Beispielansichten</NavLink>
        @foreach (var group in InstanceStore.Instances.GroupBy(instance => instance.Group))
        {
            <details open>
                <summary>@group.Key <span>@group.Count()</span></summary>
                @foreach (var instance in group)
                {
                    <NavLink href="@($"module/{instance.Id}")">
                        @instance.Name <small>@instance.Location</small>
                    </NavLink>
                }
            </details>
        }
        <a class="instance-add" href="/instanz/neu">+ Instanz hinzufügen</a>
        <p class="muted small">Aktionen betreffen lokal verwaltete Prozesse; extern gestartete Module werden nicht beendet.</p>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <div><span class="eyebrow">Lokale Anlage</span><div>@MasterText</div></div>
            <div class="actions">
                <button @onclick="ResumeMasterAsync" disabled="@(_busy || _commandBusy || !_masterAvailable || _masterStatus?.Current.Mode == SimMode.Running)">Fortsetzen</button>
                <button @onclick="PauseMasterAsync" disabled="@(_busy || _commandBusy || !_masterAvailable || _masterStatus?.Current.Mode == SimMode.Paused)">Pause</button>
                <button @onclick="StartPlant" disabled="@(_busy || _commandBusy || AllRunning)">@(_busy ? "Start läuft…" : "Alles starten")</button>
                <button @onclick="RequestCloseAll" disabled="@(_busy || _commandBusy)">Alles geordnet schließen</button>
            </div>
        </header>
        @if (_confirmClose)
        {
            <div class="preview-notice" role="status">
                <span>Geordnet schließen? Verwaltete Module werden gestoppt; Zustandsverlust bleibt möglich.</span>
                <button @onclick="CloseAll" disabled="@(_busy || _commandBusy)">Ja, geordnet schließen</button>
                <button @onclick="() => { _confirmClose = false; }">Abbrechen</button>
            </div>
        }
        @if (_results.Count > 0)
        {
            <div class="preview-notice" role="status">
                <span>@string.Join(" · ", _results.Select(result => result.ToString()))</span>
            </div>
        }
        <div class="preview-notice" role="status">
            <span>@(_lastNotice ?? "Alles starten: Time Master (pausiert) → Gateway → Wetter → Geräte. Danach Fortsetzen klicken, damit die Zeit läuft. Ein- und Ausschalten in den Instanz-Einstellungen.")</span>
        </div>
        <main id="main-content">@Body</main>
        <footer>RabbitMQ-Status auf der Live-Seite · Master bleibt beim Start pausiert <span>Master-Bedienung mit Rückmeldung · Gerätebefehle folgen</span></footer>
    </div>
</div>
@code {
    private readonly CancellationTokenSource _stop = new();
    private Task? _refreshTask;
    private MasterStatus? _masterStatus;
    private bool _masterAvailable;
    private bool _commandBusy;
    private string MasterText => _masterStatus is null ? "Master: noch kein Status empfangen"
        : $"Virtuelle Zeit: {_masterStatus.SimTime:dd.MM.yyyy HH:mm:ss} · {(_masterStatus.Current.Mode == SimMode.Paused ? "Pausiert" : "Läuft")} · Tempo {_masterStatus.Current.Speed:g} · Lauf {_masterStatus.Current.RunId}"
          + (_masterAvailable ? (_masterStatus.Current.Sequence != _masterStatus.Latest.Sequence ? " · Zustandswechsel angekündigt" : "") : " · nicht aktuell bestätigt");

    protected override void OnInitialized() => _refreshTask = RefreshMasterAsync();

    private async Task RefreshMasterAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            do
            {
                await InvokeAsync(() =>
                {
                    (_masterStatus, _masterAvailable) = MasterControl.Snapshot();
                    StateHasChanged();
                });
            } while (await timer.WaitForNextTickAsync(_stop.Token));
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }

    private Task ResumeMasterAsync() => SendMasterAsync(true);
    private Task PauseMasterAsync() => SendMasterAsync(false);
    private async Task SendMasterAsync(bool running)
    {
        if (_commandBusy || _busy) return;
        _commandBusy = true;
        try { _lastNotice = await MasterControl.SendAsync(running, _stop.Token); }
        finally { _commandBusy = false; }
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        if (_refreshTask is not null) await _refreshTask;
        _stop.Dispose();
    }

    private IReadOnlyList<StartStepResult> _results = Array.Empty<StartStepResult>();
    private string? _lastNotice;
    private bool _confirmClose;
    private bool _busy;

    private bool AllRunning => InstanceStore.Instances.All(instance =>
        instance.Kind is ModuleKind.Broker ||
        ProcessManager.State(instance) is InstanceRunState.ManagedRunning or InstanceRunState.ExternallyReachable);

    private async Task StartPlant()
    {
        if (_busy || _commandBusy) return;
        _busy = true;
        try
        {
            var configs = InstanceStore.StartupOrder();
            var results = new List<StartStepResult>();
            var broker = configs.FirstOrDefault(instance => instance.Kind == ModuleKind.Broker);
            if (broker is not null) results.Add(await ProcessManager.StartBrokerAsync());
            var devices = configs.Where(instance => instance.ModbusPort is { }).ToList();
            foreach (var config in configs)
            {
                if (config.Kind is ModuleKind.Broker) continue;
                var result = config.Kind is ModuleKind.Gateway
                    ? await ProcessManager.SyncGatewayAsync(configs, startIfStopped: true)
                    : await ProcessManager.StartAsync(config, ProcessManager.CommandFor(config, devices));
                if (result is not null) results.Add(result);
            }
            _results = results;

            // Nach dem Start warten, bis der Time Master über MQTT erreichbar ist,
            // und ihn automatisch fortsetzen, damit die virtuelle Zeit sofort läuft.
            var masterReady = false;
            for (int i = 0; i < 20; i++) // bis zu 10 Sekunden
            {
                await Task.Delay(500);
                if (MasterControl.Snapshot().Available)
                {
                    masterReady = true;
                    break;
                }
            }

            if (masterReady)
            {
                var resumeNotice = await MasterControl.SendAsync(true, _stop.Token);
                _lastNotice = resumeNotice.StartsWith("Master bestätigt")
                    ? "Alles starten abgeschlossen; Time Master gestartet und fortgesetzt. Die virtuelle Zeit läuft."
                    : "Alles starten abgeschlossen; Time Master gestartet. Fortsetzen wurde gesendet: " + resumeNotice;
            }
            else
            {
                _lastNotice = "Alles starten abgeschlossen; Time Master gestartet (pausiert). Der Master ist noch nicht über MQTT erreichbar - bitte spaeter Fortsetzen klicken.";
            }
        }
        finally
        {
            _confirmClose = false;
            _busy = false;
            StateHasChanged();
        }
    }

    private void RequestCloseAll() => _confirmClose = true;

    private async Task CloseAll()
    {
        if (_busy || _commandBusy) return;
        _busy = true;
        try
        {
            _results = await ProcessManager.StopAllAsync(InstanceStore.Instances);
            _lastNotice = _results.Count == 0
                ? "Keine verwalteten Prozesse beendet; Broker blieb nicht berührt."
                : "Geordnetes Schließen abgeschlossen; Broker blieb unberührt.";
        }
        finally
        {
            _confirmClose = false;
            _busy = false;
            StateHasChanged();
        }
    }
}
