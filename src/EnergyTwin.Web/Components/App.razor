<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <script src="@Assets["theme.js"]"></script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["theme.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="blazor-error-ui" role="alert">
        Die Oberfläche konnte nicht aktualisiert werden. <a href="/">Neu laden</a>
    </div>
    <div id="components-reconnect-modal" role="alert">
        Verbindung zur Oberfläche unterbrochen. <a href="/">Neu verbinden</a>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
