# Nach .env kopieren und eigene Zugangsdaten einsetzen. .env niemals committen.
# Einfache Werte ohne Leerzeichen verwenden; Passwort am besten zufällig erzeugen.
RABBITMQ_DEFAULT_USER=energytwin
RABBITMQ_DEFAULT_PASS=HIER_EIN_EIGENES_ZUFAELLIGES_PASSWORT_EINTRAGEN

# InfluxDB 2: Initiale Einrichtung beim ersten Start (Passwort mindestens 8 Zeichen).
# Spätere Änderungen an diesen Werten wirken nicht auf ein bereits eingerichtetes Volume.
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=HIER_EIN_EIGENES_ZUFAELLIGES_PASSWORT_EINTRAGEN
INFLUXDB_ORG=dotnet
INFLUXDB_BUCKET=sensordata
